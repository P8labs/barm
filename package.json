{
  "name": "@p8labs/better-auth-resource-manager",
  "version": "0.1.0",
  "description": "A Better Auth plugin for rapidly building authenticated CRUD APIs",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./resource": {
      "types": "./dist/resource/index.d.ts",
      "import": "./dist/resource/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "proc": "pnpm build && cd testbench/ && pnpm i && cd ..",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "better-auth": "^1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "better-auth": "latest",
    "zod": "^4.0.0",
    "typescript": "latest"
  }
}
