{
  "name": "@p8labs/barm",
  "version": "0.0.2",
  "description": "A Better Auth plugin for rapidly building authenticated Resource Management APIs",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./resource": {
      "types": "./dist/resource/index.d.ts",
      "import": "./dist/resource/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P8labs/barm.git",
    "directory": "sdk/web"
  },
  "license": "MIT",
  "author": {
    "name": "Priyanshu Verma",
    "email": "priyanshu@p8labs.in",
    "url": "https://priyanshu.p8labs.in"
  },
  "homepage": "https://github.com/P8labs/barm#readme",
  "bugs": {
    "url": "https://github.com/P8labs/barm/issues"
  },
  "peerDependencies": {
    "better-auth": "^1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "better-auth": "latest",
    "tsup": "^8.5.0",
    "typescript": "5.7.3",
    "zod": "^4.0.0"
  }
}
